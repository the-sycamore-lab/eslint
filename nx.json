{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "!{projectRoot}/dist/**/*"],
    "production": ["default"]
  },
  "targetDefaults": {
    "check": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "nx-release-publish": {
      "dependsOn": ["build"]
    }
  },
  "release": {
    "projects": ["packages/*"],
    "projectsRelationship": "independent",
    "version": {
      "preVersionCommand": "npx nx run-many -t check build",
      "preserveMatchingDependencyRanges": false
    }
  },
  "analytics": false
}
